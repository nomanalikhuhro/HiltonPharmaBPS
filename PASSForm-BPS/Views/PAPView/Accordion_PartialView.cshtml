@model List<DsrHiltonDailySalesTeamToChemist202223>
<html>
<head>
    <style>
        table, th, td {
            border: 1px solid black;
            border-collapse: collapse;
            border-style:solid;
            
        }
        table, th{
            padding:10px;
        }

    </style>
</head>
<body>

  

    <table>
        <thead style="height:50px; background: #d71921; color: white;">
            <tr style="font-size:12px;">
                <th>Pack Code</th>
                <th>Product Name</th>
                <th>LastYear Sales(Units)</th>
                <th>LastYear Sales(Values)</th>
                <th>Unit Price</th>
                <th>Expected Business(Units)</th>
                <th>Expected Business(Values)</th>
                <th>Discount % </th>
 
            </tr>
        </thead>
        <tbody style="font-size:13px;">
             @if (Model != null)
             {
                List<tblproduct> pr = new List<tblproduct>(ViewBag.PAPProducts);
                double? unitprice = 0.0;
                @foreach (var item in Model)
                {
                    unitprice = pr.Where(x => x.PackCode == item.PackCode).FirstOrDefault().UnitPrice;
                    <tr>
                        <td>@item.PackCode</td>
                        <td>@item.ProductName</td>
                        <td style="text-align:end;">@item.SalesUnits</td>
                        <td style="text-align:end;">@item.SalesValueNp</td>
                        <td style="text-align:end;">@unitprice</td>
                        <td>
                            <input type="text" style="text-align:end; width:40%;">
                        </td>
                        <td>
                            <input disabled type="text" style="text-align:end; width:40%;">
                        </td>
                        <td>
                            <input type="text" style="text-align:end; width:40%;">
                        </td>
                    </tr>
                }
            }


        </tbody>
    </table>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/PAPScripts.js"></script>

</body>
</html>
